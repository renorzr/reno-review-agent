# Required: GitHub organization to monitor.
REVIEW_ORG=your-github-org

# Optional: restrict monitoring to one or more repositories in REVIEW_ORG.
# Comma-separated; each item can be a repository name or org/repository.
# Leave empty to monitor every accessible repository in the organization.
REVIEW_REPOS=

# Exact GitHub mention that requests a review.
REVIEW_MENTION=@your-review-agent

# Name displayed in GitHub comments and a stable, URL-safe marker used to avoid
# reviewing this agent's own Issue comments.
REVIEW_AGENT_NAME=Codex Review Agent
REVIEW_MARKER=codex-review-agent

# Leave empty to use every repository's default branch for Issue contract reviews.
# Set this when all monitored repositories use one shared integration branch.
REVIEW_ISSUE_BRANCH=

# Codex session to resume. This can also be supplied as --session-id.
REVIEW_SESSION_ID=

# Polling and local workspace settings.
# Recommended for iterative development: review new revisions every five minutes.
REVIEW_INTERVAL=300
REVIEW_STATE_DIR=.state
REVIEW_WORKTREE_ROOT=/tmp/codex-review-agent
REVIEW_CODEX_TIMEOUT=720
REVIEW_ISSUE_CODEX_TIMEOUT=600
REVIEW_GH_BIN=gh
REVIEW_CODEX_BIN=codex

# Additional scope sent to Codex for every review. Keep this on one line.
REVIEW_CONTEXT=Follow the repository's documented product, security, scale, and compatibility requirements. Do not invent requirements outside its documented scope.

# false is the safe default. Enable only on a trusted host when Codex sandboxing
# is incompatible with your local environment.
REVIEW_CODEX_BYPASS_SANDBOX=false
